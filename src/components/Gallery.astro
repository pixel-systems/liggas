---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  alts: string[];
  fit?: "cover" | "contain";
  label: string;
}

const { images, alts, fit = "cover", label } = Astro.props;
---

<div class="gallery-block" data-gallery data-single={images.length < 2 || undefined}>
  <ul class:list={["gallery", fit]}>
    {
      images.map((image, index) => (
        <li>
          <button type="button" class="shot" data-shot>
            <Image
              src={image}
              alt={alts[index] ?? ""}
              widths={fit === "contain" ? [480, 900] : [420, 800, 1200]}
              sizes={
                fit === "contain"
                  ? "(min-width: 800px) 420px, 100vw"
                  : "(min-width: 980px) 33vw, 50vw"
              }
            />
          </button>
        </li>
      ))
    }
  </ul>
  <dialog class="lightbox" aria-label={label}>
    <button class="lightbox-close" type="button" data-close aria-label="Zavrieť">
      ×
    </button>
    <button
      class="lightbox-prev"
      type="button"
      data-prev
      aria-label="Predchádzajúca fotografia"
    >
      ‹
    </button>
    <img alt="" />
    <button
      class="lightbox-next"
      type="button"
      data-next
      aria-label="Nasledujúca fotografia"
    >
      ›
    </button>
    <p class="lightbox-count" data-count></p>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    if (root.dataset.bound === "true") return;
    root.dataset.bound = "true";
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-shot]")];
    const dialog = root.querySelector("dialog");
    const full = dialog?.querySelector("img");
    const count = dialog?.querySelector("[data-count]");
    if (!dialog || !full || !count || buttons.length === 0) return;

    let index = 0;
    const show = (next: number) => {
      index = (next + buttons.length) % buttons.length;
      const source = buttons[index]?.querySelector("img");
      if (!source) return;
      full.src = source.currentSrc || source.src;
      full.alt = source.alt;
      count.textContent = `${index + 1} / ${buttons.length}`;
      if (!dialog.open) dialog.showModal();
    };

    buttons.forEach((button, buttonIndex) => {
      button.addEventListener("click", () => show(buttonIndex));
    });
    dialog.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-prev]")?.addEventListener("click", () => show(index - 1));
    dialog.querySelector("[data-next]")?.addEventListener("click", () => show(index + 1));
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("cancel", () => dialog.close());
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        show(index + 1);
      }
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(index - 1);
      }
    });
  });
</script>
